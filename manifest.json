{
  "manifest_version": 3,
  "name": "EDHPORT",
  "version": "2.1.0",
  "description": "Export Commander decks from Archidekt and Moxfield to EDH Power Level",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://moxfield.com/*",
    "https://edhpowerlevel.com/*",
    "https://archidekt.com/*",
    "https://api.moxfield.com/*",
    "https://www.archidekt.com/*",
    "https://api.archidekt.com/*",
    "https://www.moxfield.com/*",
    "https://api.scryfall.com/*",
    "https://commanderspellbook.com/*",
    "https://www.cardmarket.com/*",
    "https://cardmarket.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "action.html",
    "default_title": "EDHPORT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://edhpowerlevel.com/*", "https://commanderspellbook.com/*"],
      "js": ["content-malformed-url.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://archidekt.com/*",
        "https://www.archidekt.com/*",
        "https://moxfield.com/*",
        "https://www.moxfield.com/*"
      ],
      "js": ["content-export.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardmarket.com/*/Wants/*",
        "https://cardmarket.com/*/Wants/*"
      ],
      "js": ["content-cardmarket-wants.js"],
      "run_at": "document_idle"
    }
  ]
}
